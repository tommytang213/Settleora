[Unit]
Description=Settleora unattended Codex auto-runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/repos/Settleora
Environment=PATH=/opt/flutter/bin:/home/tommytang213/bin:/home/tommytang213/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /workspace/repos/Settleora/tools/auto-runner/settleora-auto-runner.mjs --run --max-runtime 8h --max-iterations 20

# Example only. Do not enable this service until Tommy approves the real-run policy.
