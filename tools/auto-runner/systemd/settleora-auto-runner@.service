[Unit]
Description=Settleora detached auto-runner supervisor worker %i
Documentation=file:/workspace/repos/Settleora/docs/workflow/AUTONOMOUS_CODEX_RUNNER_SUPERVISOR.md

[Service]
Type=exec
WorkingDirectory=/workspace/repos/Settleora
ExecStart=/usr/bin/env node /workspace/auto-runner/.runtime.launcher.mjs --runtime-root /workspace/auto-runner/runtime --entry supervisor/settleora-auto-runner-worker.mjs -- %i --logs-root /workspace/logs/auto-runner/Settleora
UMask=0077
Restart=no
KillMode=process
TimeoutStopSec=30min
SendSIGKILL=no
EnvironmentFile=-/workspace/logs/auto-runner/Settleora/secrets/supervisor.env
StandardOutput=journal
StandardError=journal

[Install]
# Future #912 template only. Do not install or enable before the external runtime
# and profile paths above are manually deployed and verified.
