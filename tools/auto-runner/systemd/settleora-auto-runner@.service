[Unit]
Description={{PROJECT_ID}} detached auto-runner supervisor worker %i
Documentation=file:{{RUNTIME_ROOT}}/README.md

[Service]
Type=exec
WorkingDirectory={{RUNTIME_ROOT}}
ExecStart=/usr/bin/env node {{LAUNCHER}} --runtime-root {{RUNTIME_ROOT}} --entry supervisor/settleora-auto-runner-worker.mjs -- %i --logs-root {{LOGS_ROOT}}
UMask=0077
Restart=no
KillMode=process
TimeoutStopSec=30min
SendSIGKILL=no
EnvironmentFile=-{{LOGS_ROOT}}/secrets/supervisor.env
StandardOutput=journal
StandardError=journal

[Install]
# Future #912 template only. Do not install or enable before the external runtime
# and profile paths above are manually deployed and verified.
