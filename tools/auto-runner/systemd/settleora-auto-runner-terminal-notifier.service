[Unit]
Description=Settleora auto-runner terminal ntfy activity notifier
Documentation=file:/workspace/repos/Settleora/docs/workflow/AUTONOMOUS_CODEX_RUNNER_MONITORING.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/workspace/repos/Settleora
ExecStart=/usr/bin/env node /workspace/auto-runner/.runtime.launcher.mjs --runtime-root /workspace/auto-runner/runtime --entry settleora-auto-runner-terminal-notifier.mjs -- --config /workspace/auto-runner/config/settleora.json
UMask=0077
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/workspace/logs/auto-runner/Settleora/monitoring -/workspace/auto-runner/.runtime.consumers
ReadOnlyPaths=/workspace/repos/Settleora /workspace/auto-runner/runtime /workspace/auto-runner/config/settleora.json /workspace/logs/auto-runner/Settleora/supervisor /workspace/logs/auto-runner/Settleora/summaries /workspace/logs/auto-runner/Settleora/state /workspace/logs/auto-runner/Settleora/locks /workspace/logs/auto-runner/Settleora/secrets
RestrictSUIDSGID=yes
LockPersonality=yes
# Node/V8 needs runtime executable-memory permission transitions, so
# MemoryDenyWriteExecute is intentionally omitted for this Node unit.

# Repository template only. Install/start/enablement and live ntfy secrets
# require the later manual deployment gate.
