{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tommytang213/Settleora/tools/release/day1-release-identity.schema.json",
  "title": "Settleora Day 1 release identity manifest v1",
  "$comment": "This schema validates structural shape only. Consumers MUST also run the repository-owned validateManifest semantic validator, which enforces migration ordering, counts, digests, source identity, and cross-field relationships.",
  "type": "object",
  "required": ["schema", "identityDigestAlgorithm", "identityDigest", "generatedAt", "source", "apiImage", "dependencyImages", "migrations", "userWeb", "android", "releaseNotes", "rollback", "retention"],
  "properties": {
    "schema": { "const": "settleora.day1-release-identity.v1" },
    "identityDigestAlgorithm": { "const": "sha256(canonical-json-v1;excludes=generatedAt,identityDigest)" },
    "identityDigest": { "$ref": "#/$defs/hexSha256" },
    "generatedAt": { "type": "string", "format": "date-time", "anyOf": [
      { "pattern": "^[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" },
      { "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26]))|(?:(?:[02468][048]|[13579][26])00))-02-29T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" }
    ] },
    "source": { "type": "object", "additionalProperties": false, "required": ["repository", "commit", "tree", "candidateId", "exactSource", "cleanTrackedCheckout"], "properties": { "repository": { "const": "tommytang213/Settleora" }, "commit": { "$ref": "#/$defs/sha40" }, "tree": { "$ref": "#/$defs/sha40" }, "candidateId": { "type": "string", "maxLength": 255, "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$" }, "exactSource": { "const": true }, "cleanTrackedCheckout": { "const": true } } },
    "apiImage": { "$ref": "#/$defs/apiImage" },
    "dependencyImages": { "type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [
      { "allOf": [{ "$ref": "#/$defs/dependencyImage" }, { "properties": { "name": { "const": "caddy" }, "repository": { "const": "docker.io/library/caddy" }, "configuredTag": { "const": "caddy:2.11.4-alpine" } } }] },
      { "allOf": [{ "$ref": "#/$defs/dependencyImage" }, { "properties": { "name": { "const": "postgres" }, "repository": { "const": "docker.io/library/postgres" }, "configuredTag": { "const": "postgres:16-alpine" } } }] },
      { "allOf": [{ "$ref": "#/$defs/dependencyImage" }, { "properties": { "name": { "const": "rabbitmq" }, "repository": { "const": "docker.io/library/rabbitmq" }, "configuredTag": { "const": "rabbitmq:3.13-management-alpine" } } }] }
    ], "items": false, "allOf": [
      { "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "caddy" } } }, "minContains": 1, "maxContains": 1 },
      { "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "postgres" } } }, "minContains": 1, "maxContains": 1 },
      { "contains": { "type": "object", "required": ["name"], "properties": { "name": { "const": "rabbitmq" } } }, "minContains": 1, "maxContains": 1 }
    ] },
    "migrations": { "type": "object", "additionalProperties": false, "required": ["stateClaim", "runtimeInventory", "ordering", "setDigestAlgorithm", "setSha256", "count", "entries", "source"], "properties": { "stateClaim": { "const": "repository-source-only-not-applied" }, "runtimeInventory": { "const": "compiled-ef-metadata-v1" }, "ordering": { "const": "migration-id-byte-order-v1" }, "setDigestAlgorithm": { "const": "sha256(canonical-json-v1:migration-entries)" }, "setSha256": { "$ref": "#/$defs/hexSha256" }, "count": { "type": "integer", "minimum": 1 }, "source": { "$ref": "#/$defs/sourcePair" }, "entries": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "files"], "properties": { "id": { "type": "string", "pattern": "^[0-9]{14}_[A-Za-z0-9_]+$" }, "files": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/migrationFile" } } } } } } },
    "userWeb": { "type": "object", "additionalProperties": false, "required": ["schema", "source", "dependencyLock", "buildTools", "artifact"], "properties": { "schema": { "const": "settleora.user-web-dist-manifest.v1" }, "source": { "$ref": "#/$defs/sourcePair" }, "dependencyLock": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "lockfileVersion"], "properties": { "path": { "const": "apps/web-user/package-lock.json" }, "sha256": { "$ref": "#/$defs/hexSha256" }, "lockfileVersion": { "type": "integer" } } }, "buildTools": { "type": "object", "additionalProperties": false, "required": ["node", "npm", "typescript", "vite"], "properties": { "node": { "type": "string", "minLength": 1 }, "npm": { "type": "string", "minLength": 1 }, "typescript": { "type": "string", "minLength": 1 }, "vite": { "type": "string", "minLength": 1 } } }, "artifact": { "type": "object", "additionalProperties": false, "required": ["treeDigestAlgorithm", "treeSha256", "fileCount", "totalBytes"], "properties": { "treeDigestAlgorithm": { "const": "sha256(canonical-file-records-v1)" }, "treeSha256": { "$ref": "#/$defs/hexSha256" }, "fileCount": { "type": "integer", "minimum": 1 }, "totalBytes": { "type": "integer", "minimum": 1 } } } } },
    "android": { "type": "object", "additionalProperties": false, "required": ["source", "semanticVersion", "buildNumber", "applicationId", "r8Minified", "r8MappingSha256", "signingState", "signingInputSha256", "signerCertificateSha256", "apk", "aab", "outputMetadataSha256", "buildProvenanceSha256"], "properties": { "source": { "$ref": "#/$defs/sourcePair" }, "semanticVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }, "buildNumber": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "applicationId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" }, "r8Minified": { "const": true }, "r8MappingSha256": { "$ref": "#/$defs/hexSha256" }, "signingState": { "const": "debug-signing-non-store-ready" }, "signingInputSha256": { "$ref": "#/$defs/hexSha256" }, "signerCertificateSha256": { "$ref": "#/$defs/hexSha256" }, "apk": { "$ref": "#/$defs/apkFile" }, "aab": { "$ref": "#/$defs/aabFile" }, "outputMetadataSha256": { "$ref": "#/$defs/hexSha256" }, "buildProvenanceSha256": { "$ref": "#/$defs/hexSha256" } } },
    "releaseNotes": { "$ref": "#/$defs/note" },
    "rollback": { "type": "object", "additionalProperties": false, "required": ["sourceCommit", "apiImage", "artifactAvailabilityProvesDatabaseSchemaFileRollbackSafety", "safetyCaveat"], "properties": { "sourceCommit": { "$ref": "#/$defs/sha40" }, "apiImage": { "$ref": "#/$defs/apiImage" }, "artifactAvailabilityProvesDatabaseSchemaFileRollbackSafety": { "const": false }, "safetyCaveat": { "const": "Artifact availability does not prove database, schema, or file rollback safety." } } },
    "retention": { "type": "object", "additionalProperties": false, "required": ["canonicalEvidenceDirectory", "policy", "apiRegistryIdentity"], "properties": { "canonicalEvidenceDirectory": { "const": "/workspace/logs/settleora-release-candidates/{source.candidateId}", "description": "Canonical template; substitute the already required and validated source.candidateId. Candidate identity is not duplicated as unconstrained data." }, "policy": { "$ref": "#/$defs/publicText" }, "apiRegistryIdentity": { "$ref": "#/$defs/publicText" } } }
  },
  "additionalProperties": false,
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hexSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ociPlatformName": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "sourcePair": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/sha40" }, "tree": { "$ref": "#/$defs/sha40" } } },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": { "path": { "type": "string" }, "size": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hexSha256" } } },
    "migrationFile": { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "pattern": "^(?!.*\\.\\.)services/api/src/Settleora\\.Api/Persistence/Migrations/(?:[A-Za-z0-9][A-Za-z0-9._+:-]*/)*[0-9]{14}_[A-Za-z0-9_]+(?:\\.Designer)?\\.cs$" } } }] },
    "apkFile": { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "apps/mobile/build/app/outputs/flutter-apk/app-release.apk" } } }] },
    "aabFile": { "allOf": [{ "$ref": "#/$defs/file" }, { "properties": { "path": { "const": "apps/mobile/build/app/outputs/bundle/release/app-release.aab" } } }] },
    "safeLabel": { "type": "string", "pattern": "^(?!.*\\.\\.)(?!.*(?:AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{24,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{12,}|xox[baprs]-[A-Za-z0-9-]{20,}))(?!(?:.*(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Xx]-[Gg][Oo][Oo][Gg]-[Aa][Pp][Ii]-[Kk][Ee][Yy]):[A-Za-z0-9._/+:-]{8,}))[A-Za-z0-9][A-Za-z0-9._/+:-]*$" },
    "publicText": { "type": "string", "minLength": 1, "allOf": [{ "pattern": "^[^\\r\\n\\u0000]+$" }, { "pattern": "^(?!.*(?:/home/|/tmp/|\\\\Users\\\\))" }, { "pattern": "^(?!.*(?:-----BEGIN [^-\\r\\n]*PRIVATE KEY[^-\\r\\n]*-----|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{24,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{12,}|xox[baprs]-[A-Za-z0-9-]{20,}))" }, { "pattern": "^(?!.*(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Xx]-[Gg][Oo][Oo][Gg]-[Aa][Pp][Ii]-[Kk][Ee][Yy])[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9._~+/-]{8,})" }, { "pattern": "^(?!.*[Bb][Ee][Aa][Rr][Ee][Rr]\\s+[A-Za-z0-9._~+/-]{12,})" }, { "pattern": "^(?!.*[\"'](?:[Cc][Ll][Ii][Ee][Nn][Tt]_[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh]_[Tt][Oo][Kk][Ee][Nn])[\"']\\s*:)" }, { "pattern": "^(?!.*(?:_[Aa][Uu][Tt][Hh][Tt][Oo][Kk][Ee][Nn]|_[Aa][Uu][Tt][Hh]|[Nn][Pp][Mm][Aa][Uu][Tt][Hh][Tt][Oo][Kk][Ee][Nn])\\s*[:=]\\s*[^\\s\"']+)" }, { "pattern": "^(?!.*[Hh][Tt][Tt][Pp][Ss]?://[^/@\\s]+:[^/@\\s]+@)" }] },
    "releaseNoteSummary": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!.*(?:/home/|/tmp/|\\\\Users\\\\|-----BEGIN |AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{24,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{12,}|xox[baprs]-[A-Za-z0-9-]{20,}|[Bb][Ee][Aa][Rr][Ee][Rr] +[A-Za-z0-9._~+/-]{12,}))[A-Za-z0-9][A-Za-z0-9 .,'()_+/-]*$" },
    "note": { "type": "object", "additionalProperties": false, "required": ["source", "sha256", "size", "candidateSummary"], "properties": { "source": { "$ref": "#/$defs/safeLabel" }, "sha256": { "$ref": "#/$defs/hexSha256" }, "size": { "type": "integer", "minimum": 1 }, "candidateSummary": { "$ref": "#/$defs/releaseNoteSummary" } } },
    "apiImage": { "type": "object", "additionalProperties": false, "required": ["repository", "configuredTag", "indexDigest", "platformDigest", "os", "architecture", "ociRevision", "publicationRunUrl"], "properties": { "repository": { "const": "ghcr.io/tommytang213/settleora-api" }, "configuredTag": { "type": "string", "pattern": "^sha-[0-9a-f]{40}$" }, "indexDigest": { "$ref": "#/$defs/digest" }, "platformDigest": { "$ref": "#/$defs/digest" }, "os": { "$ref": "#/$defs/ociPlatformName" }, "architecture": { "$ref": "#/$defs/ociPlatformName" }, "ociRevision": { "$ref": "#/$defs/sha40" }, "publicationRunUrl": { "type": "string", "pattern": "^https://github\\.com/tommytang213/Settleora/actions/runs/[1-9][0-9]*$" } } },
    "dependencyImage": { "type": "object", "additionalProperties": false, "required": ["name", "repository", "configuredTag", "indexDigest", "platformDigest", "os", "architecture", "sourceComposePath"], "properties": { "name": { "enum": ["caddy", "postgres", "rabbitmq"] }, "repository": { "type": "string" }, "configuredTag": { "type": "string", "pattern": "^(?!(?:.*:)?(?:main|latest)$).+$" }, "indexDigest": { "$ref": "#/$defs/digest" }, "platformDigest": { "$ref": "#/$defs/digest" }, "os": { "$ref": "#/$defs/ociPlatformName" }, "architecture": { "$ref": "#/$defs/ociPlatformName" }, "sourceComposePath": { "const": "infra/docker-compose.truenas-lan.image.yml" } } }
  }
}
