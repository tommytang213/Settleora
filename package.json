{
  "name": "settleora-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node tools/doctor-validation.mjs",
    "doctor:validation": "node tools/doctor-validation.mjs",
    "doctor:docker": "node tools/doctor-validation.mjs --docker",
    "doctor:mobile": "node tools/doctor-validation.mjs --mobile",
    "validate": "node tools/validate.mjs",
    "validate:docs": "node tools/validate-docs.mjs",
    "validate:scaffold": "node tools/validate-scaffold.mjs",
    "validate:theme-tokens": "node tools/validate-theme-tokens.mjs",
    "validate:openapi": "redocly lint packages/contracts/openapi/settleora.v1.yaml",
    "generate:clients": "node tools/generate-clients.mjs",
    "generate:native-install-handoff": "node tools/auto-runner/generate-semantic-recovery-native-install-handoff.mjs",
    "validate:clients": "node tools/validate-clients.mjs",
    "validate:api": "dotnet test services/api/Settleora.Api.sln",
    "validate:api-local": "node tools/doctor-validation.mjs && dotnet test services/api/Settleora.Api.sln",
    "validate:compose": "docker compose --env-file infra/env/.env.example -f infra/docker-compose.yml config",
    "validate:compose:truenas-lan": "docker compose --env-file infra/env/.env.truenas-lan.example -f infra/docker-compose.truenas-lan.yml config",
    "validate:compose:truenas-lan-image": "docker compose --env-file infra/env/.env.truenas-lan.example -f infra/docker-compose.truenas-lan.image.yml config",
    "validate:api-docker": "docker compose --env-file infra/env/.env.example -f infra/docker-compose.yml build api",
    "validate:api-docker-local": "node tools/doctor-validation.mjs --docker && npm run validate:compose && npm run validate:api-docker",
    "validate:mobile": "node tools/doctor-validation.mjs --mobile && cd apps/mobile && flutter pub get && flutter analyze && flutter test",
    "validate:api-runtime": "node tools/validate-api-runtime.mjs",
    "validate:api-migrations": "node tools/validate-api-migrations.mjs",
    "doctor:npm": "node tools/diagnose-npm-env.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.34.0",
    "yaml": "^2.8.3"
  }
}
