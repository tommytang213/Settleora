# Settleora TrueNAS LAN Docker testing example environment.
# Copy this file to a private env file before running the LAN compose package.
# Do not commit the private env file or real generated secrets.
#
# Generate fresh strong values for:
# - POSTGRES_PASSWORD
# - RABBITMQ_DEFAULT_PASS
#
# Replace the /mnt/... paths with persistent TrueNAS dataset paths that the
# Docker runtime can read/write. The API storage dataset contains sensitive
# receipt/proof/QR file bytes and must not be exposed as a public share.

POSTGRES_DB=settleora
POSTGRES_USER=settleora_lan
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_PASSWORD
SETTLEORA_POSTGRES_HOST_PATH=/mnt/POOL/apps/settleora/postgres

RABBITMQ_DEFAULT_USER=settleora_lan
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_GENERATED_RABBITMQ_PASSWORD
SETTLEORA_RABBITMQ_HOST_PATH=/mnt/POOL/apps/settleora/rabbitmq

SETTLEORA_ENVIRONMENT=Development
COMPOSE_PROJECT_NAME=settleora_lan
SETTLEORA_API_BIND_ADDRESS=0.0.0.0
SETTLEORA_API_HTTP_PORT=8080
SETTLEORA_API_BASE_URL=http://TRUENAS_LAN_IP:8080

SETTLEORA_STORAGE_PROVIDER=Local
SETTLEORA_STORAGE_ROOT=/var/lib/settleora/storage
SETTLEORA_API_STORAGE_HOST_PATH=/mnt/POOL/apps/settleora/api-storage
